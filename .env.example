# Copy to .env next to docker-compose.yml. .env is gitignored; never commit real
# secrets. Docker Compose reads this file automatically.

# ---------------------------------------------------------------------------
# Required by docker-compose.yml
# ---------------------------------------------------------------------------

# Public host Traefik routes to this service. Also used as the session cookie
# domain. Defaults to tracker.fullcontrolmtg.com if unset.
APP_DOMAIN=tracker.fullcontrolmtg.com

# Postgres password. Compose refuses to start without it.
# Production: use the value from the Jenkins credential
#   `life-tracker-postgres-password`.
# Local development: any value works, but it must match the password in
#   DATABASE_URL below (the backend default assumes `lifetracker`).
POSTGRES_PASSWORD=lifetracker

# ---------------------------------------------------------------------------
# Local backend (`make api`). The defaults in backend/internal/config are
# already correct for `make db`; uncomment only what you need to change.
# ---------------------------------------------------------------------------
# APP_ENV=development
# ADDR=:8080
# DATABASE_URL=postgres://lifetracker:lifetracker@localhost:5433/lifetracker?sslmode=disable

# Session cookie. SESSION_COOKIE_SECURE defaults to true outside development;
# localhost is not HTTPS, so it stays off there.
# SESSION_COOKIE_NAME=lt_session
# SESSION_COOKIE_DOMAIN=
# SESSION_COOKIE_SECURE=false
# SESSION_TTL=720h
# PASSWORD_RESET_TTL=1h

# Directory holding the built frontend. Empty in development (Vite serves it);
# the image sets this to /app/web.
# STATIC_DIR=

# Only used when the frontend is served from a different origin than the API.
# Credentialed CORS needs an explicit allowlist - no wildcards.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Local frontend (`make web`). Copy to frontend/.env.local if needed.
# ---------------------------------------------------------------------------
# Where the Vite dev server proxies /api. Defaults to http://localhost:8080.
# VITE_DEV_API_TARGET=http://localhost:8080

# Overrides the API base URL baked into the bundle. Defaults to /api/v1
# (same origin); set only to point the SPA at a remote API.
# VITE_API_BASE=/api/v1
